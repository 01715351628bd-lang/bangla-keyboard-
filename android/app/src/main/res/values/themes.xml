<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Activities (Onboarding & Settings) -->
    <style name="Theme.KothaPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorPrimaryVariant">@color/primary_emerald_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- Key button styles -->
    <style name="KeyboardKeyStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/key_text_dark</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
